rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Só acessa dados quem concluiu login + 2FA (claim definido pela Cloud Function).
    function verified() {
      return request.auth != null && request.auth.token.twofa == true;
    }

    // Tudo do tutor (perfil, pets, planos, agendamentos) é privado a ele.
    match /users/{uid} {
      allow read, write: if verified() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if verified() && request.auth.uid == uid;
      }
    }

    // Horários ocupados dos petshops: todos leem (para montar a grade), cada um só cria/apaga os seus.
    match /slots/{slotId} {
      allow read: if verified();
      allow create: if verified() && request.resource.data.tutorUid == request.auth.uid;
      allow delete: if verified() && resource.data.tutorUid == request.auth.uid;
    }

    // loginCodes e mail: apenas as Cloud Functions (Admin SDK) acessam.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
