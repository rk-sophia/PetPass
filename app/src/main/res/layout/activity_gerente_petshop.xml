<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roxo_profundo_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Painel Gerente do Pet Shop"
        android:textColor="@color/amarelo_luz"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtAgendamentosGerente"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/roxo_escuro_card"
        android:padding="14dp"
        android:text="Carregando atendimentos da loja..."
        android:textColor="@color/branco_suave"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSairGerente"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="@color/roxo_eletrico"
        android:text="SAIR"
        android:textColor="@color/branco_suave" />

</LinearLayout>