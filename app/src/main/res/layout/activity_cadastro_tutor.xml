<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roxo_profundo_bg"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Criar Conta PetPass"
            android:textColor="@color/branco_suave"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/edtNomeCadastro"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/roxo_escuro_card"
            android:hint="Nome Completo"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:textColor="@color/branco_suave"
            android:textColorHint="@color/cinza_suave"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtEmailCadastro"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/roxo_escuro_card"
            android:hint="E-mail (para 2FA)"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textColor="@color/branco_suave"
            android:textColorHint="@color/cinza_suave"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtSenhaCadastro"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/roxo_escuro_card"
            android:hint="Senha (mínimo 6 caracteres)"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/branco_suave"
            android:textColorHint="@color/cinza_suave"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtEnderecoCadastro"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/roxo_escuro_card"
            android:hint="Endereço Completo / CEP"
            android:inputType="textPostalAddress"
            android:padding="12dp"
            android:textColor="@color/branco_suave"
            android:textColorHint="@color/cinza_suave"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnSalvarTutor"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/roxo_neon"
            android:text="CADASTRAR E VALIDAR E-MAIL"
            android:textColor="@color/branco_suave"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>