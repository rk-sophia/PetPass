<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cadastrar Novo Pet"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imgFotoPet"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="center"
        android:src="@android:drawable/ic_menu_camera"
        android:background="#E0E0E0"
        android:scaleType="centerCrop"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnEscolherFoto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecionar Foto do Pet"
        android:layout_gravity="center"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/etNomePet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nome do Pet"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Espécie:"
        android:layout_marginTop="12dp" />

    <Spinner
        android:id="@+id/spinnerEspecie"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <LinearLayout
        android:id="@+id/layoutPorteCondicional"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Porte do Cão:" />

        <Spinner
            android:id="@+id/spinnerPorte"
            android:layout_width="match_parent"
            android:layout_height="48dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSalvarPet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Salvar Pet e Escolher Plano"
        android:layout_marginTop="24dp" />
</LinearLayout>