<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roxo_profundo_bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Painel Administrador (Segurança)"
            android:textColor="@color/dourado_original"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/txtRelatorioAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/roxo_escuro_card"
            android:padding="14dp"
            android:text="Carregando métricas..."
            android:textColor="@color/branco_suave"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suspender / Banir Usuário por E-mail:"
            android:textColor="@color/lilas_claro"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtEmailBanir"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/roxo_escuro_card"
            android:hint="E-mail da conta"
            android:padding="12dp"
            android:textColor="@color/branco_suave"
            android:textColorHint="@color/cinza_suave"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnBanirUsuario"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/dourado_queimado"
            android:text="BANIR / SUSPENDER CONTA"
            android:textColor="@color/branco_suave"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSairAdmin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/roxo_eletrico"
            android:text="SAIR DO PAINEL"
            android:textColor="@color/branco_suave" />

    </LinearLayout>
</ScrollView>