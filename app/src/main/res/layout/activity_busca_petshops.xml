<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roxo_profundo_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pet Shops Parceiros"
        android:textColor="@color/branco_suave"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/txtInfoPlanoBusca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pet selecionado • Plano atual"
        android:textColor="@color/lilas_claro"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/edtFiltroEndereco"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/roxo_escuro_card"
        android:hint="Filtrar por bairro, rua ou nome..."
        android:padding="12dp"
        android:textColor="@color/branco_suave"
        android:textColorHint="@color/cinza_suave"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPetshops"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>