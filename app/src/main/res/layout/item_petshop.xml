<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/roxo_escuro_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtNomeLojaItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pet Spa"
            android:textColor="@color/branco_suave"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPlanoExigidoItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SILVER"
            android:textColor="@color/amarelo_luz"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtEnderecoLojaItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Av. Goiás, 1200"
        android:textColor="@color/cinza_suave"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnAcaoLojaItem"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:backgroundTint="@color/roxo_neon"
        android:text="AGENDAR HORÁRIO"
        android:textColor="@color/branco_suave"
        android:textStyle="bold" />

</LinearLayout>