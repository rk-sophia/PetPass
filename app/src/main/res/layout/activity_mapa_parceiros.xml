<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/painelAgendamento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tvNomePetShopSelecionado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selecione um Pet Shop no mapa"
            android:textStyle="bold"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/spinnerServico"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/spinnerHorario"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp" />

        <Spinner
            android:id="@+id/spinnerLembrete"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp" />

        <CheckBox
            android:id="@+id/cbAdicionarAgenda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salvar na agenda do celular (Google Calendar)"
            android:checked="true" />

        <Button
            android:id="@+id/btnConfirmarAgendamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agendar Banho / Tosa"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</LinearLayout>
