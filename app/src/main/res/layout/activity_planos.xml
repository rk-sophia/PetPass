<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roxo_profundo_bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escolha o Plano do Pet"
            android:textColor="@color/branco_suave"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cada pet possui sua própria assinatura e benefícios."
            android:textColor="@color/lilas_claro"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- PLANO SILVER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/roxo_escuro_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PET SILVER • R$ 59,90/mês"
                android:textColor="@color/cinza_suave"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="• 2 banhos mensais em lojas Silver\n• Desconto de 5% em lojas parceiras\n• Acesso ao ranking de check-ins"
                android:textColor="@color/off_white"
                android:textSize="13sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnAssinarSilver"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:backgroundTint="@color/roxo_eletrico"
                android:text="SELECIONAR SILVER"
                android:textColor="@color/branco_suave"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PLANO GOLD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/roxo_escuro_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PET GOLD • R$ 99,90/mês"
                android:textColor="@color/amarelo_luz"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="• 4 banhos + 1 tosa higiênica/mês\n• Acesso a lojas Silver e Gold\n• 10% de desconto + brindes mensais"
                android:textColor="@color/off_white"
                android:textSize="13sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnAssinarGold"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:backgroundTint="@color/roxo_neon"
                android:text="SELECIONAR GOLD"
                android:textColor="@color/branco_suave"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PLANO PLATINUM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/roxo_base"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PET PLATINUM • R$ 159,90/mês"
                android:textColor="@color/dourado_original"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="• Banhos ilimitados + Tosa completa\n• Acesso total a todas as lojas Premium\n• 20% de desconto + kit VIP"
                android:textColor="@color/branco_suave"
                android:textSize="13sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnAssinarPlatinum"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:backgroundTint="@color/dourado_original"
                android:text="SELECIONAR PLATINUM"
                android:textColor="@color/roxo_profundo_bg"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>