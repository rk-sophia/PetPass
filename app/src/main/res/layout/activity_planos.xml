<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTituloPlanoPet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Planos Linha Pata"
            android:textSize="22sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgPlanos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <RadioButton
                android:id="@+id/rbBronze"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🥉 Pata de Bronze — R$ 69,90/mês (2 Banhos)" />

            <RadioButton
                android:id="@+id/rbPrata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🥈 Pata de Prata — R$ 119,90/mês (4 Banhos)" />

            <RadioButton
                android:id="@+id/rbOuro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🥇 Pata de Ouro — R$ 169,90/mês (4 Banhos + 1 Tosa)"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbDiamante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💎 Pata de Diamante — R$ 249,90/mês (Ilimitado + VIP)" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forma de Pagamento"
            android:textStyle="bold"
            android:textSize="18sp" />

        <RadioGroup
            android:id="@+id/rgPagamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbPix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PIX Instantâneo"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbCartao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cartão de Crédito"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/layoutPix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="12dp">

            <ImageView
                android:id="@+id/imgQrPix"
                android:layout_width="180dp"
                android:layout_height="180dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escaneie o PIX acima para ativação imediata" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutCartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/etNumeroCartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Número do Cartão"
                android:inputType="number" />

            <EditText
                android:id="@+id/etValidadeCvv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Validade (MM/AA) e CVV" />
        </LinearLayout>

        <Button
            android:id="@+id/btnConfirmarAssinatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmar Pagamento e Ativar Plano"
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>