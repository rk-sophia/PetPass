<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐾 PetPass"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtituloAuth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entre na sua conta de tutor"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/blocoFormularioPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutCamposCadastro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nome Completo" />

                <EditText
                    android:id="@+id/etTelefone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Telefone com DDD (ex: 11999998888)"
                    android:inputType="phone"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/etCep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="CEP"
                    android:inputType="number"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/etEndereco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Endereço Completo"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="E-mail"
                android:inputType="textEmailAddress"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/etSenha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Senha"
                android:inputType="textPassword"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnAcaoAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Entrar"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tvAlternarModo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Não tem conta? Cadastre-se agora"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:padding="16dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/blocoVerificarTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enviamos um código SMS para o seu telefone. Digite abaixo:"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etCodigoSms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Código de 6 dígitos (SMS)"
                android:inputType="number"
                android:maxLength="6"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnValidarTelefone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Validar Telefone"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/blocoVerificarEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telefone verificado! Agora digite o código enviado para o seu e-mail:"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etCodigoEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Código de 6 dígitos (E-mail)"
                android:inputType="number"
                android:maxLength="6"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnValidarEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Concluir Cadastro e Entrar"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressAuth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>