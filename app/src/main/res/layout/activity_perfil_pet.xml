<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <ImageView
            android:id="@+id/imgLogoPerfil"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/favcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTituloPet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cadastre seus Pets e Escolha os Planos"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imgLogoPerfil" />

        <TextView
            android:id="@+id/tvSubtituloPet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cadastre um ou mais pets. Pets do mesmo porte ganham 20% de desconto no plano a partir do 2º pet!"
            android:textColor="#666666"
            android:textSize="12sp"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTituloPet" />

        <!-- Counter Badge for Pets added so far -->
        <TextView
            android:id="@+id/tvResumoPets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#F0E5FF"
            android:padding="12dp"
            android:text="Pets cadastrados até agora: 0"
            android:textColor="#9C4DEB"
            android:textStyle="bold"
            android:textSize="14sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/tvSubtituloPet" />

        <ImageView
            android:id="@+id/imgPetFoto"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="16dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvResumoPets" />

        <TextView
            android:id="@+id/tvUploadFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Toque para adicionar foto"
            android:textColor="#888888"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imgPetFoto" />

        <TextView
            android:id="@+id/lblTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tipo do Pet:"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUploadFoto" />

        <Spinner
            android:id="@+id/spTipoPet"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:entries="@array/tipos_pet"
            app:layout_constraintTop_toBottomOf="@+id/lblTipo" />

        <EditText
            android:id="@+id/etNomePet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Nome do Pet"
            android:inputType="textCapWords"
            app:layout_constraintTop_toBottomOf="@+id/spTipoPet" />

        <EditText
            android:id="@+id/etRacaPet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Raça"
            android:inputType="textCapWords"
            app:layout_constraintTop_toBottomOf="@+id/etNomePet" />

        <TextView
            android:id="@+id/lblPorte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Porte do Pet:"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etRacaPet" />

        <Spinner
            android:id="@+id/spPortePet"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:entries="@array/portes_pet"
            app:layout_constraintTop_toBottomOf="@+id/lblPorte" />

        <TextView
            android:id="@+id/lblPlano"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Selecione o Plano do Pet:"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/spPortePet" />

        <Spinner
            android:id="@+id/spPlanoPet"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:entries="@array/planos_pet"
            app:layout_constraintTop_toBottomOf="@+id/lblPlano" />

        <Button
            android:id="@+id/btnAdicionarOutroPet"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#9C4DEB"
            android:text="+ Adicionar este Pet e cadastrar outro"
            app:strokeColor="#9C4DEB"
            app:layout_constraintTop_toBottomOf="@+id/spPlanoPet" />

        <Button
            android:id="@+id/btnSalvarPet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#9C4DEB"
            android:text="Avançar para Checkout"
            app:layout_constraintTop_toBottomOf="@+id/btnAdicionarOutroPet" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
