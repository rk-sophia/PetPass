<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roxo_profundo_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- CABEÇALHO PETPASS: Saudação + Seletor de Pet + Plano -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtSaudacaoTutor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Olá, Tutor!"
                        android:textColor="@color/lilas_claro"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/spnSeletorPetHome"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="@color/branco_suave" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtBadgePlano"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_plano"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="PLANO GOLD"
                    android:textColor="@color/roxo_profundo_bg"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnSairApp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Sair"
                    android:src="@android:drawable/ic_lock_power_off"
                    app:tint="@color/rosa_pastelo" />
            </LinearLayout>

            <!-- BARRA DE BUSCA RÁPIDA -->
            <LinearLayout
                android:id="@+id/btnBarraBuscaPetshops"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_busca_petpass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/lilas_vibrante" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Buscar pet shops, banho ou tosa..."
                    android:textColor="@color/cinza_suave"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- CARD 1: PRÓXIMO AGENDAMENTO & CHECK-IN -->
            <LinearLayout
                android:id="@+id/cardProximoAgendamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_petpass"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PRÓXIMO AGENDAMENTO"
                        android:textColor="@color/amarelo_luz"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtStatusAgendamento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hoje • 14:30"
                        android:textColor="@color/lilas_claro"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtNomePetshopAgendado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Nenhum horário agendado"
                    android:textColor="@color/branco_suave"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDetalhesServicoAgendado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Toque em buscar para agendar o cuidado do seu pet"
                    android:textColor="@color/cinza_suave"
                    android:textSize="13sp"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btnAcaoPrincipalCard"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/roxo_neon"
                    android:text="FAZER CHECK-IN (LER QR CODE)"
                    android:textColor="@color/branco_suave"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- CARD 2: RANKING & CHECK-INS REALIZADOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_petpass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ranking &amp; Frequência"
                        android:textColor="@color/branco_suave"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtNivelRankingPet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Nível: Pet Explorador • Continue assim!"
                        android:textColor="@color/lilas_claro"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/txtQtdCheckins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/dourado_original"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="check-ins"
                        android:textColor="@color/cinza_suave"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- SEÇÃO: SERVIÇOS & BENEFÍCIOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explorar por categoria"
                android:textColor="@color/branco_suave"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cardCatBanho"
                        android:layout_width="130dp"
                        android:layout_height="95dp"
                        android:background="@drawable/bg_card_petpass"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛁"
                            android:textSize="24sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Banho &amp; Spa"
                            android:textColor="@color/branco_suave"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardCatTosa"
                        android:layout_width="130dp"
                        android:layout_height="95dp"
                        android:background="@drawable/bg_card_petpass"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✂️"
                            android:textSize="24sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Tosa Estética"
                            android:textColor="@color/branco_suave"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardCatBrindes"
                        android:layout_width="130dp"
                        android:layout_height="95dp"
                        android:background="@drawable/bg_card_petpass"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎁"
                            android:textSize="24sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Brindes &amp; Lojas"
                            android:textColor="@color/branco_suave"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- BANNER PROMOCIONAL / UPGRADE DE PLANO -->
            <LinearLayout
                android:id="@+id/bannerUpgradePlano"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_petpass"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Desbloqueie Pet Shops Premium ✨"
                    android:textColor="@color/dourado_claro"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Conheça os planos Silver, Gold e Platinum com banhos ilimitados e descontos progressivos."
                    android:textColor="@color/off_white"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BARRA DE NAVEGAÇÃO INFERIOR -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/roxo_escuro_card"
        app:itemIconTint="@color/lilas_vibrante"
        app:itemTextColor="@color/branco_suave"
        app:menu="@menu/menu_bottom_nav" />

</RelativeLayout>